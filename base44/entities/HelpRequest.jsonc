{
  "name": "HelpRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "problem": {
      "type": "string",
      "title": "Problem Description"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "open",
        "resolved"
      ],
      "default": "open"
    }
  },
  "required": [
    "name",
    "problem"
  ]
}