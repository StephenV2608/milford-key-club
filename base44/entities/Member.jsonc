{
  "name": "Member",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "grade": {
      "type": "string",
      "title": "Grade",
      "enum": [
        "9",
        "10",
        "11",
        "12"
      ]
    },
    "class_year": {
      "type": "string",
      "title": "Graduation Year (e.g. 2027)"
    },
    "password": {
      "type": "string",
      "title": "Member Password"
    },
    "active": {
      "type": "boolean",
      "title": "Active Member",
      "default": true
    },
    "photo_url": {
      "type": "string",
      "title": "Profile Photo URL"
    },
    "interests": {
      "type": "string",
      "title": "Interests",
      "format": "textarea"
    },
    "skills": {
      "type": "string",
      "title": "Skills"
    },
    "past_roles": {
      "type": "string",
      "title": "Past Roles in Club",
      "format": "textarea"
    },
    "officer_role": {
      "type": "string",
      "title": "Officer Role (grants admin access)",
      "enum": [
        "",
        "President",
        "Vice President",
        "Secretary",
        "Treasurer",
        "Editor",
        "Webmaster",
        "Fundraising Chairperson",
        "Social Chairperson",
        "Service Chairperson"
      ]
    },
    "admin_permissions": {
      "type": "array",
      "title": "Admin Permissions",
      "items": {
        "type": "string",
        "enum": [
          "announcements",
          "messages",
          "events",
          "people",
          "hours",
          "forms",
          "resources",
          "news",
          "gallery",
          "showcase",
          "officers",
          "pages",
          "settings"
        ]
      }
    }
  },
  "required": [
    "name",
    "email"
  ]
}